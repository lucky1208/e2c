# ── Alibaba Cloud Bailian: text model ─────────────────────────────────────────
# Use an API key and endpoint from the SAME region/workspace.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_TEXT_MODEL=qwen-plus

# ── Optional legacy WebRTC realtime voice ────────────────────────────────────
# The current multi-user release focuses on text, accounts, billing and uploads.
# Keep these only if you still use the old realtime voice endpoint.
DASHSCOPE_REALTIME_URL=
DASHSCOPE_REALTIME_MODEL=qwen-audio-3.1-realtime-plus
DASHSCOPE_REALTIME_VOICE=longanqian_v3.1
DASHSCOPE_REALTIME_API_KEY=

# ── Bailian long-term memory (optional) ──────────────────────────────────────
BAILIAN_MEMORY_BASE_URL=
BAILIAN_MEMORY_API_KEY=
BAILIAN_MEMORY_PROJECT_ID=english-ai-tutor
BAILIAN_MEMORY_LIBRARY_ID=

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
# New Supabase dashboards call this "Publishable key"; older dashboards call it "anon public".
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_. Required only for full auth-account deletion.
SUPABASE_SERVICE_ROLE_KEY=

# ── Rate limiting ────────────────────────────────────────────────────────────
# Required for public multi-user production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# For a single personal deployment only. Never use this for public multi-user traffic.
SINGLE_USER_MODE=false

# ── Product ──────────────────────────────────────────────────────────────────
# Used for email confirmation redirects. Set to your local/public URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000